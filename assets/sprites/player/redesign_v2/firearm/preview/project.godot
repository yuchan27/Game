config_version=5
[application]
config/name="R17 firearm isolated art preview"
run/main_scene="res://preview.tscn"
[display]
window/size/viewport_width=1480
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07,0.08,0.09,1)
